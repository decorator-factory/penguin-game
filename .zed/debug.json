[
    {
        "label": "Debug game",
        "build": {
            "command": "cargo",
            "args": ["build"]
        },
        "program": "$ZED_WORKTREE_ROOT/target/debug/penguin-game",
        "args": ["play", "--new-level"],
        // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
        "sourceLanguages": ["rust"],
        "request": "launch",
        "adapter": "CodeLLDB"
    }
]
